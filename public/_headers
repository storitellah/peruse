# Cloudflare Pages headers for Peruse.
# https://developers.cloudflare.com/pages/configuration/headers/

# Cross-origin isolation lets onnxruntime-web use multi-threaded WASM for the
# on-device CLIP model. `credentialless` keeps the isolation while still
# allowing the one-time model download from the Hugging Face CDN. If isolation
# is unavailable the model simply runs single-threaded — nothing breaks.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Content-hashed bundles never change — cache them hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Always revalidate the entry document so new deploys are picked up.
/index.html
  Cache-Control: no-cache
